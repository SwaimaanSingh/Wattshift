# Copy to .env and fill in what you have. Both are OPTIONAL — the app works
# without either, it just loses the AI fallback and roof auto-detection.

# Gemini API key, used only when regex parsing returns low confidence.
# Get one at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Google Solar API key (Building Insights). Enable the Solar API in your
# Google Cloud project. Without it the app uses typical SA roof assumptions.
VITE_GOOGLE_SOLAR_API_KEY=

# Formspree (or similar) endpoint for the "get quotes" enquiry form.
# Without it the form falls back to a mailto: link, which needs no backend.
VITE_ENQUIRY_FORM_ENDPOINT=
